// Foundry account, project, model deployments and container registry.
//
// Based on the Foundry layer generated by `azd ai agent init --infra=bicep`. Agents are injected
// into a delegated subnet, so hosted agents reach the private data stores; the account itself
// stays public so developers and azd can deploy from outside the network. The project's managed
// identity pulls hosted-agent images from the registry. Project connections are in
// foundry-connections.bicep.

type deploymentType = {
  name: string
  model: {
    name: string
    format: string
    version: string
  }
  sku: {
    name: string
    capacity: int
  }
}

param location string
param tags object = {}
param accountName string
param projectName string
param registryName string
param deployments deploymentType[]
param logAnalyticsId string
@description('Subnet for agent network injection. Only takes effect when the account is created.')
param agentSubnetId string

var roles = {
  acrPull: '7f951dda-4ed3-4680-a7ca-43fe172d538d'
  foundryUser: '53ca6127-db72-4b80-b1b0-d745d6d5456d'
  logAnalyticsReader: '73c42c96-874c-492b-b04d-ab87d138a893'
}

resource account 'Microsoft.CognitiveServices/accounts@2025-06-01' = {
  name: accountName
  location: location
  tags: tags
  sku: {
    name: 'S0'
  }
  kind: 'AIServices'
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    allowProjectManagement: true
    customSubDomainName: accountName
    publicNetworkAccess: 'Enabled'
    disableLocalAuth: true
    networkInjections: [
      {
        scenario: 'agent'
        subnetArmId: agentSubnetId
        useMicrosoftManagedNetwork: false
      }
    ]
  }

  // ARM throttles concurrent deployments on one account.
  @batchSize(1)
  resource modelDeployments 'deployments' = [
    for d in deployments: {
      name: d.name
      properties: {
        model: d.model
      }
      sku: d.sku
    }
  ]

  resource project 'projects' = {
    name: projectName
    location: location
    identity: {
      type: 'SystemAssigned'
    }
    properties: {
      description: 'CS AI platform sample'
      displayName: projectName
    }
    dependsOn: [
      modelDeployments
    ]
  }
}

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: registryName
  location: location
  tags: tags
  sku: {
    name: 'Basic'
  }
  properties: {
    adminUserEnabled: false
    publicNetworkAccess: 'Enabled'
  }
}

resource projectAcrPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, account::project.id, roles.acrPull)
  scope: registry
  properties: {
    principalId: account::project.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.acrPull)
  }
}

// Cloud evaluations run as the project identity: they read and write datasets in the project.
resource projectFoundryUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(account.id, account::project.id, roles.foundryUser)
  scope: account
  properties: {
    principalId: account::project.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.foundryUser)
  }
}

// Lets Foundry read agent traces for trace-based evaluations.
resource logAnalytics 'Microsoft.OperationalInsights/workspaces@2023-09-01' existing = {
  name: last(split(logAnalyticsId, '/'))
}

resource projectLogReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(logAnalyticsId, account::project.id, roles.logAnalyticsReader)
  scope: logAnalytics
  properties: {
    principalId: account::project.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      roles.logAnalyticsReader
    )
  }
}

output accountName string = account.name
output accountId string = account.id
output accountPrincipalId string = account.identity.principalId
output projectName string = account::project.name
output projectId string = account::project.id
output projectPrincipalId string = account::project.identity.principalId
output projectEndpoint string = 'https://${account.name}.services.ai.azure.com/api/projects/${account::project.name}'
output openAiEndpoint string = 'https://${account.name}.openai.azure.com/'
output registryLoginServer string = registry.properties.loginServer
output registryId string = registry.id
output registryName string = registry.name
