# Copy to .env (gitignored) for `uv run rca-local`. Values come from your Foundry project
# (after step 5: `azd env get-values`). Authentication uses your Azure CLI/azd sign-in.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Tool source: the local MCP server (services/diagnostics-mcp, `uv run func start`) ...
DIAGNOSTICS_MCP_URL=http://localhost:7071/runtime/webhooks/mcp
# ... or a Foundry toolbox (step 6), which takes precedence when set.
# TOOLBOX_ENDPOINT=

# Optional: keep episodes in Cosmos DB instead of memory (only from inside the virtual network;
# Cosmos DB is private, see docs/adr/0003-private-data-stores.md), and export telemetry.
# COSMOS_ENDPOINT=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
